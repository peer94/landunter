{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "vite",
      "buildCommand": "npm run build"
    },
    "ssr": {
      "root": ".",
      "framework": "hono",
      "entrypoint": "server/index.ts",
      "devCommand": "tsx server/dev.ts",
      "bindings": [
        { "type": "service", "service": "app", "format": "url", "env": "APP_URL" }
      ]
    }
  },
  "rewrites": [
    { "source": "/", "destination": { "service": "ssr" } },
    { "source": "/robots.txt", "destination": { "service": "ssr" } },
    { "source": "/sitemap.xml", "destination": { "service": "ssr" } },
    { "source": "/(.*)", "destination": { "service": "app" } }
  ]
}
